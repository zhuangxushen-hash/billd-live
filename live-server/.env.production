# ========================================
# 直播系统生产环境配置
# ========================================

# ---------- 服务器配置 ----------
# 服务器域名（修改为实际域名）
SERVER_DOMAIN=your-domain.com
ADMIN_DOMAIN=admin.your-domain.com

# 服务器 IP
SERVER_IP=0.0.0.0

# ---------- 后端服务配置 ----------
# 后端服务端口
BACKEND_PORT=3000

# JWT 密钥（请使用随机字符串替换）
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# 密码加密盐值（请使用随机字符串替换）
BCRYPT_SALT_ROUNDS=10

# Session 密钥
SESSION_SECRET=your-session-secret-change-this

# ---------- SRS 流媒体服务器配置 ----------
# SRS 主机地址
SRS_HOST=live-srs

# RTMP 推流端口
SRS_RTMP_PORT=1935

# HTTP-FLV/HLS 拉流端口
SRS_HTTP_PORT=8080

# HTTPS 端口
SRS_HTTPS_PORT=19350

# ---------- 数据库配置（生产环境建议使用 MySQL） ----------
# 数据库类型: json(默认) 或 mysql
DB_TYPE=json

# MySQL 配置（如果使用 MySQL）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=billd_live
DB_USER=root
DB_PASSWORD=your-database-password

# ---------- 文件存储配置 ----------
# 文件上传大小限制（MB）
MAX_FILE_SIZE=500

# 视频存储路径
VIDEO_PATH=/app/videos

# 弹窗图片存储路径
POPUP_PATH=/app/popups

# ---------- 日志配置 ----------
# 日志级别: error, warn, info, debug
LOG_LEVEL=info

# 日志文件路径
LOG_PATH=/app/logs

# ---------- 安全配置 ----------
# 是否启用 HTTPS
ENABLE_HTTPS=true

# 是否启用 API 限流
ENABLE_RATE_LIMIT=true

# API 限流次数（每分钟）
RATE_LIMIT_MAX=100

# 是否启用推流鉴权
ENABLE_STREAM_AUTH=true

# ---------- CDN 配置（可选） ----------
# CDN 地址，用于加速静态资源
CDN_URL=

# ---------- 备份配置 ----------
# 是否启用自动备份
ENABLE_BACKUP=true

# 备份路径
BACKUP_PATH=/app/backups

# 备份保留天数
BACKUP_RETENTION_DAYS=30